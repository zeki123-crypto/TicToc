# Keep the Docker build context small & reproducible.

# VCS
.git
.gitignore
.github

# Python caches / envs
__pycache__/
*.py[cod]
.venv/
venv/
env/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Local secrets & runtime data
.env
*.env
!.env.example
downloads/
tmp/
temp/
logs/
*.log

# Docs & project meta (not needed inside the image)
*.md
LICENSE
Makefile
docker-compose.yml

# Media artifacts
*.mp4
*.mkv
*.webm
*.mov
