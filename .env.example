# ============================================================
#  TicToc Bot — environment configuration
#  Copy this file to ".env" and fill in real values.
#  On Bothost, set these in the panel's "Переменные окружения".
# ============================================================

# --- Telegram ---
# Get a token from @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Comma-separated Telegram user IDs with admin rights (optional)
ADMIN_IDS=

# --- FSM / state storage ---
# "memory"  -> in-process storage (recommended for a single instance)
# "redis"   -> shared storage (only if you run Redis)
STORAGE_TYPE=memory
# Used only when STORAGE_TYPE=redis. Also accepts the REDIS_URL env name.
REDIS_DSN=redis://localhost:6379/0

# --- Downloads ---
# Directory where temporary media is stored
DOWNLOAD_DIR=downloads

# Maximum size (in MB) of a file the bot will try to send back.
# Telegram Bot API limit is 50 MB.
MAX_FILE_SIZE_MB=50

# Maximum video duration in seconds the bot will download (0 = no limit)
MAX_DURATION_SECONDS=600

# --- Rate limiting ---
# Minimum seconds between heavy actions per user
THROTTLE_RATE=2.0

# --- Processing ---
# How many ffmpeg jobs may run concurrently across the whole bot.
# Raise on machines with more CPU/RAM for higher throughput under load.
MAX_CONCURRENT_JOBS=2

# x264 speed preset: ultrafast (fastest) .. medium. ultrafast = quickest encode.
FFMPEG_PRESET=ultrafast

# Cap the longest side of processed video (px); 0 disables. 1280 ≈ 720p,
# a good speed/quality balance (smaller files upload faster too).
MAX_DIMENSION=1280

# Background cleanup: delete temp files older than this many minutes.
TEMP_FILE_TTL_MINUTES=20

# Path to a TrueType font for watermarks. Leave empty to use the bundled font.
# WATERMARK_FONT=

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
