# ============================================================
#  TicToc Bot — environment configuration
#  Copy this file to ".env" and fill in real values.
# ============================================================

# --- Telegram ---
# Get a token from @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Comma-separated Telegram user IDs with admin rights (optional)
ADMIN_IDS=

# --- FSM / state storage ---
# "memory"  -> in-process storage (fine for a single instance / dev)
# "redis"   -> shared storage (recommended for production / scaling)
STORAGE_TYPE=redis
REDIS_DSN=redis://redis:6379/0

# --- Downloads ---
# Directory where temporary media is stored
DOWNLOAD_DIR=downloads

# Maximum size (in MB) of a file the bot will try to send back.
# Standard Bot API limit is 50 MB; a local Bot API server allows up to 2000 MB.
MAX_FILE_SIZE_MB=50

# Maximum video duration in seconds that the bot will download (0 = no limit)
MAX_DURATION_SECONDS=1800

# --- Rate limiting ---
# Minimum seconds between heavy actions per user
THROTTLE_RATE=2.0

# --- Processing ---
# How many ffmpeg jobs may run concurrently across the whole bot
MAX_CONCURRENT_JOBS=2

# Path to a TrueType font used for text watermarks
WATERMARK_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
